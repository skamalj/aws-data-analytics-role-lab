--- a/missions/D14-aurora-ml-sentiment/db/refresh_sentiment.sql	2026-11-15 05:40:42.000000000 +0000
+++ b/missions/D14-aurora-ml-sentiment/db/refresh_sentiment.sql	2026-11-15 05:41:36.688348997 +0000
@@ -1,2 +1,21 @@
--- Sentiment refresh job (run by post_deploy.py after terraform). Not implemented yet.
-SELECT 1;
+-- Sentiment refresh job (run by post_deploy.py after terraform, re-runnable).
+-- Score each review ONCE with Comprehend and store the result; the agent reads the stored result.
+CREATE EXTENSION IF NOT EXISTS aws_ml CASCADE;
+
+ALTER TABLE commerce.reviews ADD COLUMN IF NOT EXISTS sentiment text;
+ALTER TABLE commerce.reviews ADD COLUMN IF NOT EXISTS sentiment_confidence real;
+
+-- Only new / unscored reviews: Comprehend is billed per call
+UPDATE commerce.reviews r
+   SET (sentiment, sentiment_confidence) =
+       (SELECT s.sentiment, s.confidence FROM aws_comprehend.detect_sentiment(r.review_text, 'en') s)
+ WHERE r.sentiment IS NULL;
+
+-- Curated, agent-facing view: aggregates only, no review text or customer ids
+CREATE OR REPLACE VIEW reporting.product_review_sentiment AS
+SELECT product_id, coalesce(sentiment, 'PENDING') AS sentiment, count(*) AS reviews, round(avg(stars), 2) AS avg_stars
+FROM commerce.reviews
+GROUP BY product_id, coalesce(sentiment, 'PENDING');
+
+GRANT USAGE ON SCHEMA reporting TO trail_desk_app;
+GRANT SELECT ON reporting.product_review_sentiment TO trail_desk_app;
