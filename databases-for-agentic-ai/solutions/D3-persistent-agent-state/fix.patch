@@ -8,6 +8,7 @@
 import os
 from datetime import date
 
+from agentstate_reducer import MessageReducer, ReducerConfig
 from langgraph_dynamodb_checkpoint import DynamoDBSaver
 from riverbend_graph import Tool, build_graph, run_turn, serve
 
@@ -77,7 +78,13 @@
 def graph():
     global _graph
     if _graph is None:   # built on first request so configuration errors are returned, not crash the runtime
-        saver = DynamoDBSaver(os.environ["CHECKPOINT_TABLE"])
+        saver = DynamoDBSaver(
+            os.environ["CHECKPOINT_TABLE"],
+            # every checkpoint item gets ttl = now + N seconds; the table's TTL setting must use "ttl"
+            ttl_seconds=int(os.environ.get("CHECKPOINT_TTL_SECONDS", "604800")),
+            # keep the stored message history bounded (whole messages, tool-call pairs kept together)
+            reducer=MessageReducer(config=ReducerConfig(max_messages=20, min_messages=10)),
+        )
         _graph = build_graph(TOOLS, saver, SYSTEM)
     return _graph
 
@@ -85,7 +92,10 @@
 def handle(payload, session_id):
     if not payload.get("prompt"):
         return {"error": "payload needs a 'prompt'"}
-    config = {"configurable": {"thread_id": session_id,
+    if not payload.get("conversation_id"):
+        return {"error": "payload needs a 'conversation_id' (stable id of the customer's conversation)"}
+    # The runtime session is short-lived; the conversation is not. Key state on the conversation.
+    config = {"configurable": {"thread_id": f"returns-{payload['conversation_id']}",
                                "ctx": {"customer_id": payload.get("customer_id")}}}
     return run_turn(graph(), payload["prompt"], config)
 
