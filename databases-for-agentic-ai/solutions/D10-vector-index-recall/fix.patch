 -- Search settings for the application identity
-ALTER ROLE trail_desk_app SET ivfflat.probes = 1;
-ALTER ROLE trail_desk_app RESET hnsw.ef_search;
+-- probes ~ sqrt(lists): search 12 of 141 lists (higher = better recall, slower)
+ALTER ROLE trail_desk_app SET ivfflat.probes = 12;
+-- ef_search must be >= the LIMIT the application asks for (an HNSW scan returns at most ef_search rows)
+ALTER ROLE trail_desk_app SET hnsw.ef_search = 200;
