 CREATE TABLE vectors.reviews_ivf  (id int PRIMARY KEY, embedding vector(128) NOT NULL);
 CREATE TABLE vectors.reviews_hnsw (id int PRIMARY KEY, embedding vector(128) NOT NULL);
 
