 IDENT = re.compile(r"^[a-z_][a-z0-9_]*\.[a-z_][a-z0-9_]*$")    # schema.table
+MAX_ROWS = 20
+PII_COLUMNS = re.compile(r"(email|phone|full_name|address)", re.I)
+EMAIL = re.compile(r"[^@\s\"]+@[^@\s\"]+\.[a-z]{2,}", re.I)
+
+
+def cap(n):
+    """Diagnostics never need more than a handful of rows."""
+    try:
+        return max(1, min(int(n), MAX_ROWS))
+    except (TypeError, ValueError):
+        return 5
+
+
+def redact(row):
+    """Mask personal data by column name and by value shape."""
+    out = {}
+    for k, v in row.items():
+        if PII_COLUMNS.search(k):
+            out[k] = "[REDACTED]"
+        elif isinstance(v, str) and EMAIL.search(v):
+            out[k] = EMAIL.sub("[REDACTED_EMAIL]", v)
+        else:
+            out[k] = v
+    return out
 
 
