diff -ruN a/missions/D12-multi-tenant-rls/db/tenancy.sql b/missions/D12-multi-tenant-rls/db/tenancy.sql
--- a/missions/D12-multi-tenant-rls/db/tenancy.sql	2026-11-15 05:36:33.000000000 +0000
+++ b/missions/D12-multi-tenant-rls/db/tenancy.sql	2026-11-15 05:37:29.686325904 +0000
@@ -30,5 +30,12 @@
 CREATE POLICY tenant_isolation ON saas.tenant_docs
   USING (tenant_id = current_setting('app.tenant_id', true));
 
--- The SaaS service owns its table so its migrations can run without the DBA
-ALTER TABLE saas.tenant_docs OWNER TO saas_app;
+-- Table owners bypass row-level security. The service only READS; ownership stays with the admin,
+-- and FORCE makes even the owner subject to the policy (defence in depth).
+ALTER TABLE saas.tenant_docs FORCE ROW LEVEL SECURITY;
+GRANT SELECT ON saas.tenant_docs TO saas_app;
+
+-- Filtered vector search: the HNSW scan yields at most ef_search candidates BEFORE the tenant filter.
+-- With 20 tenants (~5 % each) the default 40 leaves ~2 rows; 400 leaves ~20 for a LIMIT 10.
+-- (pgvector >= 0.8, e.g. Aurora PostgreSQL 16.6+: hnsw.iterative_scan = relaxed_order keeps scanning instead.)
+ALTER ROLE saas_app SET hnsw.ef_search = 400;
