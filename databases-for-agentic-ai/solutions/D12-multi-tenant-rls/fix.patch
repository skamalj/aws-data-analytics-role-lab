+    # Every Data API call can run on a different (pooled) connection: a setting made in one call is
+    # NOT reliably visible in the next one - and a non-local setting may even leak to another request.
+    # Set the tenant and run the query in ONE transaction, with is_local = true.
+    tx = rds.begin_transaction(**DB)["transactionId"]
+    try:
+        rds.execute_statement(sql="SELECT set_config('app.tenant_id', :t, true)", transactionId=tx,
+                              parameters=[{"name": "t", "value": {"stringValue": tenant}}], **DB)
+        r = rds.execute_statement(
+            sql="SELECT id, tenant_id, title FROM saas.tenant_docs "
+                "ORDER BY embedding <=> (SELECT embedding FROM saas.tenant_docs WHERE id = :id) LIMIT :k",
+            parameters=[{"name": "id", "value": {"longValue": doc_id}}, {"name": "k", "value": {"longValue": k}}],
+            formatRecordsAs="JSON", transactionId=tx, **DB)
+    finally:
+        rds.commit_transaction(resourceArn=DB["resourceArn"], secretArn=DB["secretArn"], transactionId=tx)
     return {"tenant_id": tenant, "results": json.loads(r.get("formattedRecords") or "[]")}
