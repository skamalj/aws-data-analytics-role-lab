+        parameters=[{"name": "id", "value": {"stringValue": oid}},
+                    {"name": "cid", "value": {"stringValue": cid}}], formatRecordsAs="JSON", **DB)
     rows = json.loads(r.get("formattedRecords") or "[]")
     return rows[0] if rows else {"error": "order not found"}
 
