--- Indexes for the product search tools (applied by setup.py after catalog.sql).
--- The catalog launched without any secondary indexes.
-SELECT 1;
+-- Indexes for the product search tools (applied by setup.py after catalog.sql). Re-runnable.
+-- (Index builds can take longer than the Data API's 45 s wait; they keep running and dbsql.py moves on.)
+
+-- search_products: substring search on name and description (ILIKE '%term%') needs trigram GIN indexes
+CREATE EXTENSION IF NOT EXISTS pg_trgm;
+CREATE INDEX IF NOT EXISTS products_name_trgm ON catalog.products USING gin (name gin_trgm_ops);
+CREATE INDEX IF NOT EXISTS products_description_trgm ON catalog.products USING gin (description gin_trgm_ops);
+
+-- browse_category: equality on category + range/sort on price
+CREATE INDEX IF NOT EXISTS products_category_price ON catalog.products (category, price);
+
+-- similar_products: approximate nearest neighbours, same operator as the query (<=> cosine)
+CREATE INDEX IF NOT EXISTS products_embedding_hnsw ON catalog.products USING hnsw (embedding vector_cosine_ops);
+
+ANALYZE catalog.products;
