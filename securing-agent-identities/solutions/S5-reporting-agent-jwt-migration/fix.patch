diff -ruN a/missions/S5-reporting-agent-jwt-migration/terraform/main.tf b/missions/S5-reporting-agent-jwt-migration/terraform/main.tf
--- a/missions/S5-reporting-agent-jwt-migration/terraform/main.tf	2026-11-15 08:02:55.000000000 +0000
+++ b/missions/S5-reporting-agent-jwt-migration/terraform/main.tf	2026-11-15 08:03:26.008764521 +0000
@@ -15,7 +15,7 @@
   generate_secret                      = true
   allowed_oauth_flows_user_pool_client = true
   allowed_oauth_flows                  = ["client_credentials"]
-  allowed_oauth_scopes                 = ["${local.scopes}/reports.read"]
+  allowed_oauth_scopes                 = ["${local.scopes}/reports.read", "${local.scopes}/reports.submit"]
 }
 
 resource "aws_cognito_user_pool_client" "advisor_portal" {
@@ -76,8 +76,22 @@
     network_mode = "PUBLIC"
   }
 
+  # inbound: verified JWTs from the Compliance Portal only (this also closes the SigV4 path)
+  authorizer_configuration {
+    custom_jwt_authorizer {
+      discovery_url   = local.b.discovery_url
+      allowed_clients = [aws_cognito_user_pool_client.compliance_portal.id]
+      allowed_scopes  = ["${local.scopes}/reports.submit"]
+    }
+  }
+
+  # pass the verified token through to the agent code so it can read client_id / sub
+  request_header_configuration {
+    request_header_allowlist = ["Authorization"]
+  }
+
   environment_variables = {
     AGENT_NAME    = "regulatory-reporting"
-    IDENTITY_MODE = "payload" # legacy: the caller says who they are
+    IDENTITY_MODE = "jwt" # the filer is whoever the verified token says
   }
 }
